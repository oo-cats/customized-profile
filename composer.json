{
  "name": "local/custom-profile",
  "description": "Safe modular user profiles with controlled themes, showcases, private media and moderation",
  "type": "flarum-extension",
  "license": "MIT",
  "version": "0.2.0",
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-mbstring": "*",
    "flarum/core": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Local\\CustomProfile\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "自定义个人资料",
      "icon": {
        "name": "fas fa-id-card",
        "backgroundColor": "#326d91",
        "color": "#fff"
      }
    }
  }
}
